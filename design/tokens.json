{
  "$comment": "Tempest interface tokens, transcribed from the Template v8 Tokens board and the layer boards. Dark is the default theme. Alpha values are opacity of the hex colour.",
  "color": {
    "map-ground":    { "dark": "#1A2026",   "light": "#E6EAE2",   "use": "Map base under the layer" },
    "water":         { "dark": "#0D1317",   "light": "#BCD0E0",   "use": "Sea and lakes; dark text halo" },
    "surface":       { "dark": "#11151A", "darkAlpha": 0.92, "light": "#FFFFFF", "lightAlpha": 0.94, "use": "Top bar, round buttons" },
    "sheet":         { "dark": "#11151A", "darkAlpha": 0.96, "light": "#FFFFFF", "lightAlpha": 0.96, "use": "Bottom sheet" },
    "panel":         { "dark": "#11151A", "darkAlpha": 0.97, "light": "#FFFFFF", "lightAlpha": 0.98, "use": "Grow panels: menus, map, save" },
    "scrim":         { "dark": "#000000", "darkAlpha": 0.35, "light": "#14181D", "lightAlpha": 0.25, "use": "Over the map while a panel is open" },
    "ink":           { "dark": "#F2F4F6",   "light": "#14181D",   "use": "Text, icons, time needle, window" },
    "ink-2":         { "dark": "#A9B1BA",   "light": "#4A535D",   "use": "Run age, labels, now line" },
    "ink-3":         { "dark": "#8A939D",   "light": "#5B646E",   "use": "Unavailable, beyond the model" },
    "stroke":        { "dark": "#FFFFFF", "darkAlpha": 0.14, "light": "#14181D", "lightAlpha": 0.16, "use": "Panel edges" },
    "stroke-strong": { "dark": "#FFFFFF", "darkAlpha": 0.22, "light": "#14181D", "lightAlpha": 0.28, "use": "Control edges" },
    "fill-control":  { "dark": "#FFFFFF", "darkAlpha": 0.10, "light": "#14181D", "lightAlpha": 0.06, "use": "Selected tile, source button" },
    "card":          { "dark": "#FFFFFF", "darkAlpha": 0.045, "use": "Detail cards inside the sheet (from the detail screens)" },
    "slot-dash":     { "dark": "#FFFFFF", "darkAlpha": 0.30, "light": "#14181D", "lightAlpha": 0.30, "use": "Planned or coming-later placeholder outline" },
    "warning":       { "dark": "#F5B83D",   "light": "#B76E00",   "use": "Alert badge, stale data" }
  },
  "font": {
    "display": "'Space Grotesk', Inter, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "rules": "Space Grotesk for names and numbers that lead; Inter for the rest. Numbers tabular. 11 px is the floor."
  },
  "type": {
    "hero-value":  { "family": "display", "weight": 600, "size": 28, "example": "2.4 cm/h" },
    "time":        { "family": "display", "weight": 600, "size": 20, "example": "Fri 5 PM" },
    "stat":        { "family": "display", "weight": 600, "size": 20, "example": "−5 °C" },
    "panel-title": { "family": "display", "weight": 600, "size": 18, "example": "Map" },
    "body":        { "family": "body", "weight": 500, "size": 14, "example": "Save this area" },
    "secondary":   { "family": "body", "weight": 400, "size": 13, "example": "in 6 h · 2.5 km" },
    "caption":     { "family": "body", "weight": 400, "size": 12, "example": "18Z run · 2 h old" },
    "micro":       { "family": "body", "weight": 500, "size": 11, "example": "Wed 11 · Mt Seymour 1,449 m" }
  },
  "space": {
    "scale": [4, 8, 12, 16, 20, 34],
    "screen-edge": 16,
    "gap-controls": 8,
    "gap-groups": 12,
    "bottom-inset": 34,
    "top-bar-offset": "safe-area-inset-top + 8 (55 on the 390 x 844 artboards, which assume a 47 px status bar)"
  },
  "radius": { "chip": 3, "chart-and-time-track": 8, "button-tile-row": 12, "top-bar": 16, "sheet-top": 20, "grow-panel": 24, "icon-button": "50%" },
  "size": {
    "touch-target-min": 44,
    "thumb-button": 56,
    "top-bar-height": 56,
    "artboard-phone": [390, 844],
    "sheet-pulled-up-top": "top bar bottom + 16 (127 on the artboards)",
    "grow-panel-inset": 16
  },
  "data": {
    "$comment": "Continuous ramps; lightness carries the order. Values are sent to the GPU as numbers and coloured on the device through a lookup strip, so a ramp can change without new downloads. Only avalanche danger stays stepped, in its official colours. A ramp is added only when its layer is built.",
    "precipitation": {
      "unit": "mm/h liquid", "cutoff": 0.1, "saturatesAt": 6,
      "valueStops": [[0.1, 0], [0.5, 0.18], [2, 0.55], [6, 1]],
      "rain":  { "dark": ["#163F5C", "#1F5E86", "#2E8FBF", "#6CC4E6"], "light": ["#D4EAF6", "#A8D4EC", "#4C9FD6", "#1E5C9C"] },
      "mixed": { "dark": ["#5C3414", "#8A4B1E", "#D9792E", "#F5B97A"], "light": ["#FBE3CC", "#F5B97A", "#D9792E", "#8A4B1E"] },
      "snow":  { "dark": ["#3F2B70", "#5B3F9E", "#9A6FD6", "#D7B8F5"], "light": ["#EDE2F9", "#DCC6F3", "#A57BD8", "#6A3EA8"] },
      "textAccent": { "rain": "#6CC4E6", "snow": "#D7B8F5" }
    },
    "temperature": {
      "unit": "°C", "range": [-20, 25], "neutralAt": 0,
      "valueStops": [[-20, 0], [-8, 0.267], [-2, 0.40], [0, 0.444], [4, 0.533], [12, 0.711], [25, 1]],
      "dark":  ["#2F6FD0", "#5E92E0", "#8FB4EE", "#D9DEE3", "#F0C08A", "#F0A860", "#D9702A"],
      "light": ["#1E4FA8", "#2F6FD0", "#4C9FD6", "#9AA6B2", "#E08A3C", "#C96A22", "#9E4310"]
    },
    "wind": {
      "unit": "km/h", "range": [0, 60], "saturatesAt": 60,
      "valueStops": [[0, 0], [10, 0.167], [25, 0.417], [40, 0.667], [60, 1]],
      "dark":  ["#2A3540", "#2F6273", "#3BA08E", "#D9C35C", "#E0785C"],
      "light": ["#DCE3E8", "#7FB3C4", "#2E8C7C", "#B8962A", "#B5482C"]
    }
  }
}
