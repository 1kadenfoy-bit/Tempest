        "adapters/eccc-geomet/fixtures/raqdps*",
        "adapters/avalanche-org/**",
        "public/ates/**",
        "tools/ates-index.mjs",
        "e2e/avalanche.spec.ts",
        "e2e/ates.spec.ts",
        "e2e/alerts.spec.ts",
        "e2e/air-quality.spec.ts",
        "e2e/avalanche-test-photo.png",
        "docs/reports/safety-*/**",
        "docs/handoffs/safety/**",
        "docs/reports/air-quality/**",
        "docs/reports/ates/**",
        "docs/reports/avalanche/**",
        "docs/wishes/safety.md"
      ],
      "specs": [
        "e2e/avalanche.spec.ts",
        "e2e/ates.spec.ts",
        "e2e/alerts.spec.ts",
        "e2e/air-quality.spec.ts"
      ]
    }
  },
  "shared": {
    "$comment": "The lead's files: the connection points between sections and the project's setup. A section may change one only when its work cannot be seen without it, and says why in its handoff note.",
    "paths": [
      "app/main.ts",
      "app/state.ts",
      "layers/contract.ts",
      "core/vocabulary.ts",
      "core/units/**",
      "core/geo/**",
      "package.json",
      "package-lock.json",
      "vite.config.ts",
      "eslint.config.js",
      "tsconfig.json",
      "playwright.config.ts",
      "e2e/fixtures.ts",
      "e2e/recorded.ts",
      "e2e/phone-tests.spec.ts",
      "app/spike/**",
      "spike.html",
      "tools/check-section.mjs",
      "tools/diff-report.mjs",
      "tools/vite-plugin-app-manifest.ts",
      "CLAUDE.md",
      "README.md",
      "KICKOFF_PROMPT.md",
      "docs/0*.md",
      "docs/sections/**",
      "docs/model-data.md",
      "docs/hosting.md",
      "docs/spikes/**",
      "docs/reference/**",
      ".github/**",
      ".gitignore",
      "docs/reports/m*/**"
    ]
  },
  "nobody": [
    "design/**"
  ]
}
