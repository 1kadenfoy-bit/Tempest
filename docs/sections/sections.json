        "docs/wishes/data.md"
      ],
      "specs": [
        "e2e/offline.spec.ts",
        "e2e/models.spec.ts"
      ]
    },
    "safety": {
      "title": "Safety",
      "brief": "docs/sections/safety.md",
      "paths": [
        "app/avalanche/**",
        "app/alerts/**",
        "app/air/**",
        "layers/avalanche/**",
        "layers/air-quality/**",
        "core/avalanche/**",
        "core/alerts/**",
        "core/air/**",
        "adapters/avalanche-canada/**",
