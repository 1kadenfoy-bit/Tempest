{
  "$comment": "Who owns which files. Read by tools/check-section.mjs (the area check) and by every section chat. A section edits its own paths freely; 'shared' paths only with a reason written in its handoff note (the lead decides at integration); another section's paths never. design/ is Kaden's and nobody edits it. Patterns: * is any characters but /, ** is any depth.",
  "sections": {
    "maps": {
      "title": "Maps",
      "brief": "docs/sections/maps.md",
      "paths": [
        "app/map/**",
        "app/search/**",
        "tools/build-basemap.mjs",
        "tools/pmtiles-extract.mjs",
        "tools/regions.json",
        "tools/lib/**",
        "core/basemap/**",
        "core/pmtiles/**",
        "core/geo/terrain.ts",
        "core/geo/terrain.test.ts",
        "core/search/**",
        "adapters/bc-geonames/**",
        "public/tiles/**",
        "e2e/3d.spec.ts",
        "e2e/search.spec.ts",
        "docs/reports/maps-*/**",
        "docs/handoffs/maps/**",
        "docs/reports/3d/**",
        "docs/wishes/maps.md"
      ],
      "except": [
        "app/map/freezing-line.ts",
        "app/map/wind-field.ts",
        "app/map/image-frames.ts"
      ],
      "specs": [
        "e2e/3d.spec.ts",
        "e2e/search.spec.ts"
      ]
    },
    "interface": {
      "title": "Interface",
      "brief": "docs/sections/interface.md",
      "paths": [
        "app/shell/**",
        "app/settings/**",
        "app/summary/**",
        "app/theme/**",
        "app/fonts/**",
        "app/sources/**",
        "app/main.css",
        "index.html",
        "public/icon*",
        "public/_headers",
        "e2e/shell.spec.ts",
        "e2e/shell.spec.ts-snapshots/**",
        "e2e/settings.spec.ts",
        "e2e/summary.spec.ts",
        "e2e/details.spec.ts",
        "docs/reports/interface-*/**",
        "docs/handoffs/interface/**",
        "docs/reports/summary/**",
        "docs/wishes/interface.md"
      ],
      "specs": [
        "e2e/shell.spec.ts",
        "e2e/settings.spec.ts",
        "e2e/summary.spec.ts",
        "e2e/details.spec.ts"
      ]
    },
    "weather": {
      "title": "Weather on the map",
      "brief": "docs/sections/weather.md",
      "paths": [
        "layers/precipitation/**",
        "layers/temperature/**",
        "layers/wind/**",
        "layers/radar/**",
        "render/grid-gl/**",
        "app/weather/**",
        "app/radar/**",
        "app/stations/**",
        "app/map/freezing-line.ts",
        "app/map/wind-field.ts",
        "app/map/image-frames.ts",
        "core/color/**",
        "core/precip/**",
        "core/temperature/**",
        "core/wind/**",
        "core/elevation/**",
        "core/stations/**",
        "adapters/eccc-radar/**",
        "adapters/eccc-swob/**",
        "adapters/avcan-weather/**",
        "e2e/temperature.spec.ts",
        "e2e/wind.spec.ts",
        "e2e/radar.spec.ts",
        "e2e/stations.spec.ts",
        "docs/reports/weather-*/**",
        "docs/handoffs/weather/**",
        "docs/reports/stations/**",
        "docs/reports/radar/**",
        "docs/wishes/weather.md"
      ],
      "specs": [
        "e2e/temperature.spec.ts",
        "e2e/wind.spec.ts",
        "e2e/radar.spec.ts",
        "e2e/stations.spec.ts"
      ]
    },
    "effects": {
      "title": "Effects (3D and animation)",
      "brief": "docs/sections/effects.md",
      "paths": [
        "render/effects/**",
        "render/flow/**",
        "app/effects/**",
        "app/effects-lab/**",
        "effects.html",
        "e2e/effects.spec.ts",
        "docs/reports/effects-*/**",
        "docs/handoffs/effects/**",
        "docs/wishes/effects.md"
      ],
      "specs": [
        "e2e/effects.spec.ts"
      ]
    },
    "data": {
      "title": "Data",
      "brief": "docs/sections/data.md",
      "paths": [
        "adapters/openmeteo-maps/**",
        "adapters/openmeteo-api/**",
