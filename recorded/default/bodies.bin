[-66.0509,49.0334],[-66.0614,49.0295],[-66.0655,49.0233],[-66.0712,49.0177],[-66.0717,49.0146],[-66.076,49.0118],[-66.0885,49.0004],[-66.0946,48.9926],[-66.1088,48.9806],[-66.122,48.9721],[-66.1343,48.9668],[-66.1488,48.9628],[-66.1515,48.9609],[-66.158,48.96],[-66.1594,48.9537],[-66.1626,48.9506],[-66.1731,48.953],[-66.1878,48.9492],[-66.1916,48.9466],[-66.1977,48.9448],[-66.2238,48.9397],[-66.2381,48.9332],[-66.2416,48.9263],[-66.2437,48.9193],[-66.2439,48.908],[-66.2457,48.8931]]]]},"properties":{"centroid":[-66.08685907369768,48.90968671256848],"id":"03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762"}}],"type":"FeatureCollection"}{"items":[{"submissionID":"89e93afd-59d2-4d52-8c71-73063f277bf8","userID":"google-oauth2|100540904548708994148","username":"wardsbd","title":"Sunshine Meadows","date":"2026-11-19","submissionDatetime":"2026-11-19T22:59:58Z","updatedDatetime":"2026-11-19T23:09:07Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":51.0623171,"longitude":-115.75604959999998},"region":"Central Rockies","imageCount":5,"client":"app","images":[{"id":"min/prod/fe152246-f895-4180-9bea-08d393564d5c","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795128504/min/prod/fe152246-f895-4180-9bea-08d393564d5c.jpg","caption":"HS 35cm with facets at the bottom collapsing when digging.","width":4000,"height":3000},{"id":"min/prod/f57febb2-6eb9-4be1-99de-a66f4ffdd7de","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795128506/min/prod/f57febb2-6eb9-4be1-99de-a66f4ffdd7de.jpg","width":3000,"height":4000},{"id":"min/prod/c0ccc004-c580-4de9-8e9a-0b3f233b5ac7","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795128508/min/prod/c0ccc004-c580-4de9-8e9a-0b3f233b5ac7.jpg","width":3000,"height":4000},{"id":"min/prod/674d25ee-5743-4eba-b04c-f97fa07ff1ae","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795128511/min/prod/674d25ee-5743-4eba-b04c-f97fa07ff1ae.jpg","width":3000,"height":4000},{"id":"min/prod/2a81bdb5-320a-41f5-9ee8-17605fcf27cb","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795128514/min/prod/2a81bdb5-320a-41f5-9ee8-17605fcf27cb.jpg","width":3000,"height":4000}],"sawAvalanche":"no","instability":["whumpfing"],"comments":"A sunny calm day in the meadows.  The  Hs was 35 cm, which consisted of 15 cm of low density sugary facets(F Hard ness )  with breakable 4 cm 1F- soft tempature crust over top.  With 10 cm of low density powder( no wind effect yet)on top with small small surface hoar(3-5 mm) on the surface.\n\nGot a few good but hesitant turns on grass bottom meadows. Only hit a few small rocks.\n\nSmall whumpfs at 2300m increaseing to medium whumpfs at 2500m.\n"},{"submissionID":"19a1d4c6-43b4-420d-aed0-6a9bed7d4aa9","userID":"google-oauth2|110585569771812118831","username":"thomas.thiery01","title":"Backcountry skiing at Fraser Chutes, White Pass","date":"2026-11-18","submissionDatetime":"2026-11-19T18:06:21Z","updatedDatetime":"2026-11-19T18:29:58Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":59.71405,"longitude":-135.08564},"region":"Yukon","imageCount":2,"client":"website","images":[{"id":"c3e88b42-1eb9-4b85-8ef5-415fa8bd7551","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795111143/min/prod/c3e88b42-1eb9-4b85-8ef5-415fa8bd7551.jpg","width":1152,"height":2048},{"id":"2b147efa-1cf5-4491-b7aa-1c4bd410539a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795111144/min/prod/2b147efa-1cf5-4491-b7aa-1c4bd410539a.jpg","width":1152,"height":2048}],"sawAvalanche":"no","comments":"Backcountry skiing at Fraser Chutes, White Pass. About 50 cm of snow at the bottom of the chute (estimated, not measured) â€” early season, thin cover. Wet snow around mid-chute at about 1,150 m at the start of the day. Sunny, then cloudy. The chute had more powder and was less dense. The couloir (SW aspect) was more wind-affected and denser, but still enjoyable. One storm avalanche observed on Big Kahuna (N aspect), probably size 2, seen from a distance. No major signs of instability. Lots of roller balls and wet snow from the past week, seen everywhere. Skied from 10:00 to 17:00 on a south-southwest (SSW) aspect. The avalanche's elevation band was 1060 to 1745 m."},{"submissionID":"067feb03-431c-4dcb-852a-87c955355e4c","userID":"auth0|6afcda34e8963211b12faeb6","username":"Mike MacGregor","title":"Lazy day at Sunshine Meadows","date":"2026-11-17","submissionDatetime":"2026-11-17T22:53:21Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":51.06457,"longitude":-115.78238},"region":"Central Rockies","imageCount":4,"client":"website","images":[{"id":"94b39ea1-9b46-483e-90bd-d2e3eb698dc1","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955128/min/prod/94b39ea1-9b46-483e-90bd-d2e3eb698dc1.jpg","caption":"2900m - new snow above crust, sugar below","width":2000,"height":1500},{"id":"c2125da4-aeb1-48b4-a09b-33c67f7a8cd0","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955127/min/prod/c2125da4-aeb1-48b4-a09b-33c67f7a8cd0.jpg","caption":"2900m - sugar layer at ground","width":2000,"height":1500},{"id":"ebc4b542-15ef-433f-b1e8-4847b5173c4d","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955128/min/prod/ebc4b542-15ef-433f-b1e8-4847b5173c4d.jpg","caption":"Surface hoar, west aspect, lee slope","width":2000,"height":2667},{"id":"d5ddfc64-cb50-477f-bb94-55eb8cdf24cd","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955128/min/prod/d5ddfc64-cb50-477f-bb94-55eb8cdf24cd.jpg","caption":"Rime, west aspect, lee slope","width":2000,"height":2667}],"sawAvalanche":"no","instability":["none"],"comments":"Snow pack was highly variable from place to place - everything from just 5cm of new snow on bare rock, to HS 50cm with 15 to 20cm of drifted snow above a thin melt-freeze crust with sugar below. Where present, the crust was supportive. Ski pen varied from near zero to 15cm. Wind varied from none to a light breeze. Reasonably heavy overcast. Deep drifted snow lulled me briefly into forgetting about not-so-buried rocks :-("},{"submissionID":"e7dabda2-873c-4982-b03c-e75c6507b020","userID":"google-oauth2|114021775300373749416","username":"swskier","title":"Metal Dome","date":"2026-11-16","submissionDatetime":"2026-11-17T14:05:05Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":50.1088,"longitude":-123.18613},"region":"Southwest Coast","imageCount":1,"client":"website","images":[{"id":"f4ca8a19-0359-4b69-ac1a-a50128fdfa89","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794924051/min/prod/f4ca8a19-0359-4b69-ac1a-a50128fdfa89.jpg","width":2000,"height":2667}],"sawAvalanche":"no","instability":["windLoading","whumpfing"],"comments":"Went for a look with the new snow and expectations were exceeded. Road in good shape to parking with no snow. Walked ~25min to where trees change to open meadows and started skiing on ~30-50cm base at 1650m. Travel was only possible on skis where old snow existed underneath the fresh storm snow. At ~1850m on the N glacier, probed 185cm. Top 100cm was F-1F progressive density sitting on old snow/melt forms to ground. CT26 BRK down 50cm on a density change. Ski quality was OK with most surfaces wind blown. Ski pen 5-15cm."},{"submissionID":"5dc16163-4d1e-4e1a-afbf-1b3590ff3c14","userID":"auth0|697820b323314501f42be261","username":"Nathan Britt","title":"Hope you like rocks, cause weâ€™ve got heaps of f*cking rocks","date":"2026-11-15","submissionDatetime":"2026-11-16T13:36:23Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["hiking","snowboarding"],"location":{"latitude":51.34044,"longitude":-117.54394},"region":"Selkirks","imageCount":8,"client":"website","images":[{"id":"10147596-26c0-463b-8347-05ac800b0f85","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836068/min/prod/10147596-26c0-463b-8347-05ac800b0f85.jpg","width":2000,"height":2667},{"id":"884466f6-dfb5-48c3-995c-fe073d53606a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836071/min/prod/884466f6-dfb5-48c3-995c-fe073d53606a.jpg","width":2000,"height":2667},{"id":"3cfcd806-2df8-450c-a35d-884f3689774e","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836069/min/prod/3cfcd806-2df8-450c-a35d-884f3689774e.jpg","width":2000,"height":1500},{"id":"28807fee-50c0-4f5b-a5c5-4d028b498859","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836068/min/prod/28807fee-50c0-4f5b-a5c5-4d028b498859.jpg","width":2000,"height":2667},{"id":"830ddde7-0932-45d1-80ba-840c02a595ba","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836067/min/prod/830ddde7-0932-45d1-80ba-840c02a595ba.jpg","width":2000,"height":1500},{"id":"6709cf8f-2f60-4965-9f00-d0210cc2ab5b","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836069/min/prod/6709cf8f-2f60-4965-9f00-d0210cc2ab5b.jpg","width":2000,"height":2667},{"id":"a76166f3-089f-4e65-b6bd-e3d689dcc7c2","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836070/min/prod/a76166f3-089f-4e65-b6bd-e3d689dcc7c2.jpg","width":2000,"height":2667},{"id":"377fc8fb-3cf9-4acf-a735-114a6ca91eb1","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836070/min/prod/377fc8fb-3cf9-4acf-a735-114a6ca91eb1.jpg","width":2000,"height":2667}],"sawAvalanche":"no","instability":["none"],"comments":"Went for a trundle up hermit today to see how the alpine is shaping up. Snow line is sitting around 1650m. You can still basically hike up to the campground. I ditched the trail runners after 2.5km of hiking and managed to break some kind of a trail on skins from just below 1800m. Freezing level came up disgustingly high over the weekend, precip was still falling as rain at 2000m in the afternoon. Just under 50cm of snow sitting on the tent pads at Hermit Campground but streams are still running above 2000m. Snow quality a little nicer as you get higher above the campground. Averaging 80cm of coverage at the toe of Rogerâ€™s Glacier (2350m south-east aspect) 10 of which fell last night. \n\nTemp at valley bottom(1300m): 4 degrees\nTemp at campground (2100m): 0 degrees \nTemp at glacier (2350m): -2 degrees \n\nSummary: Keep biking."},{"submissionID":"e1f34ddc-c0e9-4c2b-b174-b4f1cfad073b","userID":"auth0|679ef32626e8b488f9351271","username":"crazyplatypus","title":"Scoping out snow at Zoa","date":"2026-11-15","submissionDatetime":"2026-11-16T02:29:47Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["hiking"],"location":{"latitude":49.6267958,"longitude":-121.0800748},"region":"Southwest Coast","imageCount":4,"client":"app","images":[{"id":"min/prod/89e7b504-4c08-404d-ad56-7924fad9278b","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795859/min/prod/89e7b504-4c08-404d-ad56-7924fad9278b.jpg","caption":"Snow at the top of the ridge (35cm)","width":5712,"height":4284},{"id":"min/prod/aa2485fd-bba5-4dc1-9490-315ef8ebd57b","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795861/min/prod/aa2485fd-bba5-4dc1-9490-315ef8ebd57b.jpg","caption":"Parking lotâ€¦. No snow :(","width":4284,"height":5712},{"id":"min/prod/111a3dfb-8c84-46d6-8767-e545632f148a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795863/min/prod/111a3dfb-8c84-46d6-8767-e545632f148a.jpg","caption":"Coming up on to the ridge","width":5712,"height":4284},{"id":"min/prod/9ffa5c4b-e25b-4449-b0dc-af9e4dbeb8d5","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795877/min/prod/9ffa5c4b-e25b-4449-b0dc-af9e4dbeb8d5.jpg","caption":"@ 1600 m","width":4284,"height":5712}],"sawAvalanche":"no","comments":"Hiked up to the ridge to scope out the snow and do some avi rescue practice but left the skis in the carâ€¦ seemed like too much boot packing for us. There was 35cm of snow on the ridge a lot of sharks. Saw a couple folks out doing a few laps though! "},{"submissionID":"bdb68a24-cbf5-4de4-92dd-1d87027d98fe","userID":"auth0|6afa46bc4a4f012e77453322","username":"maddysparkle","title":"Maddysparklez Megamind Mission","date":"2026-11-15","submissionDatetime":"2026-11-16T00:10:58Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":51.392087699999976,"longitude":-118.351759},"region":"Selkirks","imageCount":4,"client":"app","images":[{"id":"min/prod/47ebf9d3-340d-4766-a7de-3dc13b71a784","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787260/min/prod/47ebf9d3-340d-4766-a7de-3dc13b71a784.jpg","caption":"Yummy early season snow","width":3024,"height":4032},{"id":"min/prod/b653a597-2fc4-486c-991f-e413a6d1f362","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787270/min/prod/b653a597-2fc4-486c-991f-e413a6d1f362.jpg","caption":"Mmmmm alders","width":4284,"height":5712},{"id":"min/prod/556f0e5d-a8c3-459e-8419-e132d130e57a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787276/min/prod/556f0e5d-a8c3-459e-8419-e132d130e57a.jpg","caption":"Lots of rocks","width":4284,"height":5712},{"id":"min/prod/02718d3b-e737-4929-8c3a-5a0c53c5e15f","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787664/min/prod/02718d3b-e737-4929-8c3a-5a0c53c5e15f.jpg","caption":"Dawg for reference ","width":5712,"height":4284}],"sawAvalanche":"no","instability":["none"],"comments":"Up to 30cm of well consolidated snow at 1800m with 5-10cm accumulating over 24hours. Graupel \u0026 some stellar stellars overnight. Lots of wind, not much transport at our elevation. Lower elevations lost snow coverage quickly. Paw pen 5cm tested by our dawg. 10/10 would recommend an early season mission. "},{"submissionID":"4395f1fa-5b7c-4b3d-8b49-394bc6765663","userID":"google-oauth2|113028194556210400866","username":"skiasessippi","title":"Should have brought skates","date":"2026-11-14","submissionDatetime":"2026-11-15T20:04:28Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":50.627126299999986,"longitude":-116.49466239999998},"region":"Purcells","client":"app","sawAvalanche":"no","comments":"6-8 inches of snow for the entire trail and even less above the lower lake.\nSignificant surface hoar forming throughout the day. Facets at ground level. Lower lake is frozen enough for skating but the area is not skiable yet."},{"submissionID":"2d5107f2-3c6c-413f-bb48-cf93483c600c","userID":"auth0|6af9d476026c8efbeabee507","username":"ryanteppan","title":"Bow Hut to Mt Rhondda + Mount Habel (CT at base","date":"2026-11-13","submissionDatetime":"2026-11-15T16:12:28Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing","mountaineering"],"location":{"latitude":51.64950639999999,"longitude":-116.55707940000002},"region":"Central Rockies","imageCount":5,"client":"app","images":[{"id":"min/prod/6c476ce8-d562-4afc-a40b-5d9961cff339","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757980/min/prod/6c476ce8-d562-4afc-a40b-5d9961cff339.jpg","caption":"CT at base of mount Habel\n","width":1290,"height":2796},{"id":"min/prod/444248f9-a8d3-45d8-ab44-d085ce2c1576","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757982/min/prod/444248f9-a8d3-45d8-ab44-d085ce2c1576.jpg","width":1290,"height":2796},{"id":"min/prod/f9a82777-a4c3-425e-a806-a6a560549f38","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757986/min/prod/f9a82777-a4c3-425e-a806-a6a560549f38.jpg","width":1290,"height":2796},{"id":"min/prod/814917b9-4c4f-4e37-ba42-63b8468e31a9","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757989/min/prod/814917b9-4c4f-4e37-ba42-63b8468e31a9.jpg","caption":"Photo from where I lost my ski and the area it likely ended up, my ski is a Blizzard Zero G (with pin bindings-no brakes)","width":1290,"height":2796},{"id":"min/prod/dfaa56ef-5ff5-4682-9743-2bbf208b4d54","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757991/min/prod/dfaa56ef-5ff5-4682-9743-2bbf208b4d54.jpg","caption":"On way back to Bow hut-pic of my ski if anyone stumbles upon my lost one. Unlikely but my # is 403-431-2476\n","width":1290,"height":2796}],"sawAvalanche":"no","comments":"Ski touring across Wapta icefield and a summit of Rhondda on Nov. 13, 2026. Group of 3. Snow was variable with wind loading in areas, no shooting cracks or whumphing. Descended Rhondda then did a CT at the base of Mount Habel: CTM13 30cm down, RP. Included pics, At spot of the column test I lost 1 of my touring skis down the slope. Included a photo of area, if anyone finds it by chance my # is 403-431-2476. Will be going to peyto hut ~Nov 20th to look around for it. Also worth mentioning there were only a couple open crevasses around Rhondda and didnâ€™t come across any hidden crevasses while traversing to and from bow hut from that area."},{"submissionID":"4f0fa9f4-9282-40cc-a77a-d2bda5ff33b1","userID":"auth0|54ced78c4a76765d506c43a4","username":"ksharman","title":"Bullmoose snow - thumbs down","date":"2026-11-13","submissionDatetime":"2026-11-14T05:02:00Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["snowshoeing"],"location":{"latitude":55.03441990000001,"longitude":-121.51991159999999},"region":"North Rockies","imageCount":2,"client":"app","images":[{"id":"min/prod/e8c9834a-6801-4f7d-abb7-8b383ee768ee","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794632170/min/prod/e8c9834a-6801-4f7d-abb7-8b383ee768ee.jpg","width":4284,"height":5712},{"id":"min/prod/58f57bd9-d0c3-460d-8623-698001fc0197","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794632175/min/prod/58f57bd9-d0c3-460d-8623-698001fc0197.jpg","width":2944,"height":3926}],"sawAvalanche":"no","instability":["warming"],"comments":"Height of snow 35-50 cm at treeline. 10 cm pretty good powder on top. The rest of the snowpack got really baked by this weekâ€™s warmup and it probably rained high up before the 10 cm snow. Wet and mushy, almost isothermic. We were sinking in almost down to ground. Would have been challenging skiing but we were on snowshoes. "}]}{"type":"FeatureCollection","features":[],"numberMatched":0,"numberReturned":0,"links":[{"type":"application/geo+json","rel":"self","title":"This document as GeoJSON","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=json&skipGeometry=true&limit=100&bbox=-122.94810,49.38990,-122.94790,49.39010"},{"rel":"alternate","type":"application/ld+json","title":"This document as RDF (JSON-LD)","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=jsonld&skipGeometry=true&limit=100&bbox=-122.94810,49.38990,-122.94790,49.39010"},{"type":"text/html","rel":"alternate","title":"This document as HTML","href":"https://api.weather.gc.ca/collections/weather-alerts/items?f=html&skipGeometry=true&limit=100&bbox=-122.94810,49.38990,-122.94790,49.39010"},{"type":"application/json","title":"Weather Alerts","rel":"collection","href":"https://api.weather.gc.ca/collections/weather-alerts"}],"timeStamp":"2026-11-20T00:16:36.102930Z"}<?xml version='1.0' encoding="UTF-8" standalone="no" ?>
<WMS_Capabilities version="1.3.0" updateSequence="2026-11-19T23:45:01Z"  xmlns="http://www.opengis.net/wms"   xmlns:sld="http://www.opengis.net/sld"   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"   xmlns:ms="http://mapserver.gis.umn.edu/mapserver"   xsi:schemaLocation="http://www.opengis.net/wms http://schemas.opengis.net/wms/1.3.0/capabilities_1_3_0.xsd  http://www.opengis.net/sld http://schemas.opengis.net/sld/1.1.0/sld_capabilities.xsd  http://mapserver.gis.umn.edu/mapserver https://geo.weather.gc.ca/geomet?service=WMS&amp;version=1.3.0&amp;request=GetSchemaExtension">
<Service>
  <Name>WMS</Name>
  <Title>MSC GeoMet â€” GeoMet-Weather 2.40.4</Title>
  <Abstract>GeoMet-Weather provides public access to the Meteorological Service of Canada (MSC) and Environment and Climate Change Canada (ECCC) data via interoperable web services and application programming interfaces (API). Through open standards, users can freely and quickly access thousands of real-time and archived weather, climate and water datasets and products and integrate them in their domain-specific applications and decision support systems. Users can build mobile apps, create interactive web maps, and display and animate MSC data in desktop software. MSC GeoMet also enables on demand raw data clipping and reprojection, on demand format conversion and custom visualization.</Abstract>
  <KeywordList>
      <Keyword>Weather</Keyword>
      <Keyword>Meteorology</Keyword>
      <Keyword>Climate</Keyword>
      <Keyword>Forecasting</Keyword>
      <Keyword>Floods</Keyword>
      <Keyword>Weather alerts</Keyword>
