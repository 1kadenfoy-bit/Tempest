      <Keyword>Temperature</Keyword>
      <Keyword>Precipitations</Keyword>
      <Keyword>Snow</Keyword>
      <Keyword>Ice</Keyword>
  </KeywordList>
  <OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://eccc-msc.github.io/open-data/msc-geomet/readme_en/"/>
