[{"id":"37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","slug":"37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","url":"https://avalanche.ca/forecasts/37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","type":"avalancheforecast","area":{"id":"afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","name":"afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","bbox":null},"report":{"id":"37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","forecaster":"Parks Canada","dateIssued":"2026-11-16T18:30:37.400Z","validUntil":"2026-11-20T23:00:00.000Z","timezone":"America/Edmonton","title":"Banff-East Side 93N-Field-Kootenay-Lake Louise-Little Yoho-LLSA-Sunshine-West Side 93N","highlights":"\u003ch1\u003eWatch for deeper snow accumulation and slab formation in isolated alpine gully features. Climbers should watch for small wind slabs that can have serious consequences.\u003c/h1\u003e\u003cp\u003e\u003c/p\u003e","confidence":{"rating":{"value":"moderate","display":"Moderate"},"statements":["We are uncertain due to a limited number of field observations."]},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eReports are limited, but there have been no recent avalanche observations; only minor sluffing/cracking in steep alpine terrain. The main snowpack concern is small, isolated wind slabs in alpine gullies.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003e5- 15 cm of new snow on Nov. 16th is covering either bare ground, crusts or facetted snow depending on your location. Reports indicate snow depths of up to 80 cm on glaciers, while snow cover remains minimal at treeline and below. Overall, the early-season snowpack is thin and variable.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor current weather conditions, see the\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/map\"\u003etelemetry stations\u0026nbsp;\u003c/a\u003eon the Avalanche Canada map page.\u003c/p\u003e\u003cp\u003eFor weather forecasts, check out Environment Canada's products for \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.weather.gc.ca/en/location/index.html?coords=51.179,-115.569\"\u003eBanff\u003c/a\u003e, \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.weather.gc.ca/en/location/index.html?coords=50.950,-116.033\"\u003eKootenay\u003c/a\u003e and \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.weather.gc.ca/en/location/index.html?coords=51.500,-116.500\"\u003eYoho\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eFor weather maps, graphics and satellite images check out the\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eFor a technical weather forecast check out \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://spotwx.com/\"\u003eSpotWx\u003c/a\u003e\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-16T18:30:37Z","display":"Monday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-17T18:30:37Z","display":"Tuesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-18T18:30:37Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}}],"problems":[{"type":{"value":"windslab","display":"Wind Slab"},"comment":"\u003cp\u003eIsolated small wind slabs are possible in steep alpine lee terrain.\u003c/p\u003e","factors":[{"type":{"value":"elevation","display":"What Elevation?"},"graphic":{"id":"elevation-0-0-1_en","url":"https://assets.avalanche.ca/images/Elevation/Elevation-0-0-1_EN.png","alt":" Alpine"}},{"type":{"value":"aspect","display":"Which Slopes?"},"graphic":{"id":"aspect-1-1-1-1-1-1-1-1_en","url":"https://assets.avalanche.ca/images/Compass/compass-1-1-1-1-1-1-1-1_EN.png","alt":" North, Northeast, East, Southeast, south, Southwest, West, Northwest"}},{"type":{"value":"likelihood","display":"Chances of Avalanches?"},"graphic":{"id":"likelihood-unlikely_en","url":"https://assets.avalanche.ca/images/Likelihood/Likelihood-1_EN.png","alt":" Unlikely"}},{"type":{"value":"size","display":"Expected Size?"},"graphic":{"id":"size-1-2_en","url":"https://assets.avalanche.ca/images/size/Size-1-2_EN.png","alt":" Small - Small"}}],"data":{"elevations":[{"value":"alp","display":"Alpine"}],"aspects":[{"value":"nw","display":"Northwest"},{"value":"w","display":"West"},{"value":"sw","display":"Southwest"},{"value":"s","display":"s"},{"value":"n","display":"North"},{"value":"ne","display":"Northeast"},{"value":"e","display":"East"},{"value":"se","display":"Southeast"}],"aspectElevations":["n_alp","ne_alp","e_alp","se_alp","nw_alp","w_alp","sw_alp","s_alp"],"likelihood":{"value":"unlikely","display":"unlikely"},"expectedSize":{"min":"1.0","max":"1.5"}}}],"terrainAndTravelAdvice":["Be careful with wind-loaded pockets, especially near ridge crests and rollovers."],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-byk","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"notifications":[{"type":"info","content":"\u003cp\u003eArea closures for avalanche control are in effect periodically from November to May. Click \u003ca href=\"https://www.pc.gc.ca/en/pn-np/mtn/securiteenmontagne-mountainsafety/avalanche/declenchementpreventif-controlareas?_ga=2.80778963.573438189.1667223637-385521292.1638363862\"\u003ehere\u003c/a\u003e for more information and maps."}],"media":{"images":[]}},{"id":"eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","slug":"eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","url":"https://avalanche.ca/forecasts/eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","type":"avalancheforecast","area":{"id":"b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","name":"b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","bbox":null},"report":{"id":"eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","forecaster":"Parks Canada","dateIssued":"2026-11-10T20:30:16.100Z","validUntil":"2026-11-20T23:00:00.000Z","timezone":"America/Vancouver","title":"Glacier","highlights":"\u003cp\u003eSnow has started to accumulate at upper elevations, but there is not enough of a snowpack to safely travel on skis/snowboards.\u003c/p\u003e\u003cp\u003ePack a transceiver, probe \u0026amp; shovel and factor avalanches into your trip.\u003c/p\u003e\u003cp\u003eDaily avalanche hazard forecasts begin later in November.\u003c/p\u003e","confidence":{"rating":{"value":"moderate","display":"Moderate"},"statements":["We are uncertain due to a limited number of field observations."]},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eThere have been small avalanches on smooth alpine slopes during recent snowfalls.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003eSnow is slowly starting to accumulate at upper elevations, with approximately 30cm of settled snow at treeline. If you decide to give touring a go, plan for hiking at lower elevations, give yourself lots of extra time, and be cautious where wind deposits have created localized pockets of deep snow.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor current conditions check the telemetry stations by clicking on the weather station icons on the Avalanche Canada map page.\u003c/p\u003e\u003cp\u003eFor a weather forecast we recommend Environment Canada's forecast for \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://weather.gc.ca/en/location/index.html?coords=51.301,-117.521\"\u003eRoger's Pass\u003c/a\u003e\u003c/p\u003e\u003cp\u003eFor a weather maps, graphics and satellite images check the \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e\u003c/p\u003e\u003cp\u003eFor a technical forecast check out SpotWx or Windy\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-11T20:30:16Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-12T20:30:16Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-13T20:30:16Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-glacier","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"notifications":[{"type":"info","content":"\u003cp\u003eLarge areas of Glacier National Park are CLOSED for highway avalanche control using EXPLOSIVES. All areas require Winter Permits. Real-time area status is \u003cstrong\u003eonly\u003c/strong\u003e posted \u003ca href=\"https://www.pc.gc.ca/apps/Rogers-Pass\"\u003ehere\u003c/a\u003e.\u003c/p\u003e"}],"media":{"images":[]}},{"id":"9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","slug":"9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","url":"https://avalanche.ca/forecasts/9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","type":"avalancheforecast","area":{"id":"426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","name":"426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","bbox":null},"report":{"id":"9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","forecaster":"Parks Canada","dateIssued":"2026-11-13T21:00:00.000Z","validUntil":"2026-11-20T22:00:00.000Z","timezone":"America/Edmonton","title":"Brazeau-Churchill-Cirrus-Wilson-Fryatt-Icefields-Maligne-Marmot-Miette Lake-Pyramid","highlights":"\u003cp\u003e\u003cstrong\u003e\u003cem\u003eAvalanche season is upon us in the alpine.\u0026nbsp; Due to a thin snowpack, glacier travel is also at its trickiest.\u0026nbsp; Use \u0026nbsp;\u003c/em\u003e\u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.pc.gc.ca/station-eng.aspx?d=TODAY\u0026amp;r=5\"\u003e\u003cstrong\u003e\u003cem\u003eWeather Stations\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cem\u003e, the\u0026nbsp;\u003c/em\u003e\u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.mountainconditions.com/\"\u003e\u003cstrong\u003e\u003cem\u003eACMG Mountain Condition Reports\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cem\u003e, and the\u0026nbsp;\u003c/em\u003e\u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/map\"\u003e\u003cstrong\u003e\u003cem\u003eMIN\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cem\u003e for conditions; or ask for Visitor Safety at 780-852-6155.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e","confidence":{"rating":{"value":"high","display":"High"}},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eDanger is highest after new snowfall, rain, or wind transport.\u0026nbsp;\u0026nbsp; Early season faceting may have weakened the bond of the thin fall snowpack to steep ice gullies/faces.\u0026nbsp; Use extra caution in high, icy arenas â€“ Persistent Slabs have surprised parties in recent years, e.g. late season Mt Athabasca climbers.\u0026nbsp; Avalanche season is here: do your own avalanche forecasting; carry a transceiver, shovel and probe; and to know how to use them.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/early-season-conditions\"\u003eAn early season overview\u003c/a\u003e\u003c/p\u003e\u003cp\u003eWatch out for alpine areas as they gain enough snow for avalanches over the next couple of weeks. High bowls, gullies, and around ridgelines are classic spots for early season avalanches.\u003c/p\u003e\u003cp\u003eVast numbers of open late summer crevasses are now deceptively hidden, by very thin bridges of wind-blown new snow.\u0026nbsp; Roping up and diligent probing, and glacier reading experience are all critical for safe glacier travel.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor current weather conditions, see the\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/map\"\u003etelemetry stations\u0026nbsp;\u003c/a\u003eon the Avalanche Canada map page.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e is available from Avalanche Canada\u003c/p\u003e\u003cp\u003eDetailed local forecasts are available on your favorite weather app.\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-13T21:00:00Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-14T21:00:00Z","display":"Saturday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-15T21:00:00Z","display":"Sunday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-jasper","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"notifications":[{"type":"info","content":"Seasonal closures for caribou conservation in Jasper National Park are in effect from November to May. For more information, \u003ca href=\"https://www.pc.gc.ca/en/pn-np/ab/jasper/nature/conservation/retablissement-caribou-recovery/mesuresap-bcactions\"\u003eclick here.\u003c/a\u003e"}],"media":{"images":[]}},{"id":"cf50334f-3c6b-478b-b02f-dd9ecb233074_010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","slug":"cf50334f-3c6b-478b-b02f-dd9ecb233074_010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","url":"https://avalanche.ca/forecasts/cf50334f-3c6b-478b-b02f-dd9ecb233074_010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","type":"avalancheforecast","area":{"id":"010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","name":"010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","bbox":null},"report":{"id":"cf50334f-3c6b-478b-b02f-dd9ecb233074_010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","forecaster":"Parks Canada","dateIssued":"2026-10-07T19:00:00.000Z","validUntil":"2026-12-01T00:00:00.000Z","timezone":"America/Edmonton","title":"Waterton","highlights":"\u003cp\u003eAvalanche hazard may exist where there is snow. Consider winter conditions in your trip planning and pay close attention to weather forecasts.\u003c/p\u003e","confidence":{"rating":{"value":"noRating","display":"No Rating"}},"summaries":[{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eConsult the\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/weather/forecast\"\u003e Mountain Weather Forecast\u003c/a\u003e for the most up-to-date weather conditions.\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-10-07T19:00:00Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-10-08T19:00:00Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-10-09T19:00:00Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-waterton","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"media":{"images":[]}},{"id":"5f1836ba-f92c-448a-a615-d8f413b0e1e9_2b27cc579bf40b0d3360a5ffe527102213d07f32526775c4e2f0af58e02f8d3d","slug":"5f1836ba-f92c-448a-a615-d8f413b0e1e9_2b27cc579bf40b0d3360a5ffe527102213d07f32526775c4e2f0af58e02f8d3d","url":"https://avalanche.ca/forecasts/5f1836ba-f92c-448a-a615-d8f413b0e1e9_2b27cc579bf40b0d3360a5ffe527102213d07f32526775c4e2f0af58e02f8d3d","type":"avalancheforecast","area":{"id":"2b27cc579bf40b0d3360a5ffe52