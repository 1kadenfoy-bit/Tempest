dangerRatings":[{"date":{"value":"2026-10-02T23:00:00Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-10-03T23:00:00Z","display":"Saturday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-10-04T23:00:00Z","display":"Sunday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":false},"version":1,"owner":{"value":"avalanche-canada","display":"Avalanche Canada","isExternal":false,"url":"https://avalanche.ca/en"},"media":{"images":[]}},{"id":"fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","slug":"fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","url":"https://avalanche.ca/forecasts/fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","type":"avalancheforecast","area":{"id":"d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","name":"d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","bbox":null},"report":{"id":"fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","forecaster":"Kananaskis","dateIssued":"2026-11-16T23:30:34.800Z","validUntil":"2026-11-20T23:00:00.000Z","timezone":"America/Vancouver","title":"Bow Valley-Highwood Pass-North 40-Spray - KLakes","highlights":"\u003cp\u003eLee and cross-loaded features in higher alpine terrain could have pockets of wind slab. Ice climbers and scramblers should be mindful of the consequences of even a small avalanche. Check out this link for some information on \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/early-season-conditions\"\u003eEarly Season Conditions\u003c/a\u003e\u003c/p\u003e","confidence":{"rating":{"value":"low","display":"Low"}},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eNo recent observations or reports.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003eField observations are very minimal. 20-30cm of snow can be found in higher Alpine areas. Isolated pockets of wind slab in lee and cross-loaded features are possible with slabs up to 50cm deep due to wind loading. The snowpack does not have a lot of layering structure at this time and any avalanche that initiates is likely to fail at the ground.\u003c/p\u003e\u003cp\u003eIce climbers should be thinking about overhead terrain and the influence of winds and warmer temperatures, potentially making triggering more likely.\u003c/p\u003e\u003cp\u003eEven a small avalanche can have big consequences if a terrain trap, such as a cliff or confined gully, is part of the equation.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eMore details can be found in the \u003ca href =\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e.\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-17T23:30:34Z","display":"Tuesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-18T23:30:34Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-19T23:30:34Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":false},"version":1,"owner":{"value":"kananaskis","display":"Kananaskis","isExternal":false,"url":"https://avalanche.ca/en/forecasts/kananaskis"},"notifications":[{"type":"info","content":"\u003cp\u003eAreas of Kananaskis Country are intermittently closed for avalanche control using EXPLOSIVES. Closures will be indicated in headline below.\u003c/p\u003e"}],"media":{"images":[]}},{"id":"f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","slug":"f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","url":"https://avalanche.ca/forecasts/f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","type":"avalancheforecast","area":{"id":"03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","name":"03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","bbox":null},"report":{"id":"f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","forecaster":"Avalanche QuÃ©bec","dateIssued":"2026-11-04T13:15:53.800Z","validUntil":"2026-12-01T23:00:00.000Z","timezone":"America/New_York","title":"Chic-Chocs","highlights":"\u003cp\u003e\u003cstrong\u003eTHE BULLETINS WILL BE BACK ON DECEMBER 1ST, 2026.\u003cbr\u003eStay safe in the mountains!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e","confidence":{"rating":{"value":"noRating","display":"No Rating"}},"summaries":[{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor the coming weeks, we encourage you to consult the recommended public weather resources when planning a mountain outing, which are available \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanchequebec.ca/previsions-meteo-publiques/\"\u003ehere\u003c/a\u003e.\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-05T13:15:53Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"noforecast","display":"No Forecast"}},"tln":{"display":"Treeline","rating":{"value":"noforecast","display":"No Forecast"}},"btl":{"display":"Below Treeline","rating":{"value":"noforecast","display":"No Forecast"}}}},{"date":{"value":"2026-11-06T13:15:53Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"noforecast","display":"No Forecast"}},"tln":{"display":"Treeline","rating":{"value":"noforecast","display":"No Forecast"}},"btl":{"display":"Below Treeline","rating":{"value":"noforecast","display":"No Forecast"}}}},{"date":{"value":"2026-11-07T13:15:53Z","display":"Saturday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"noforecast","display":"No Forecast"}},"tln":{"display":"Treeline","rating":{"value":"noforecast","display":"No Forecast"}},"btl":{"display":"Below Treeline","rating":{"value":"noforecast","display":"No Forecast"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"avalanche-quebec","display":"Avalanche QuÃ©bec","isExternal":false,"url":"https://avalanchequebec.ca"},"media":{"images":[]}},{"id":"37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","slug":"37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","url":"https://avalanche.ca/forecasts/37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","type":"avalancheforecast","area":{"id":"afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","name":"afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","bbox":null},"report":{"id":"37ec0e8a-af64-4c00-af6a-942d88b6567e_afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","forecaster":"Parks Canada","dateIssued":"2026-11-16T18:30:37.400Z","validUntil":"2026-11-20T23:00:00.000Z","timezone":"America/Edmonton","title":"Banff-East Side 93N-Field-Kootenay-Lake Louise-Little Yoho-LLSA-Sunshine-West Side 93N","highlights":"\u003ch1\u003eWatch for deeper snow accumulation and slab formation in isolated alpine gully features. Climbers should watch for small wind slabs that can have serious consequences.\u003c/h1\u003e\u003cp\u003e\u003c/p\u003e","confidence":{"rating":{"value":"moderate","display":"Moderate"},"statements":["We are uncertain due to a limited number of field observations."]},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eReports are limited, but there have been no recent avalanche observations; only minor sluffing/cracking in steep alpine terrain. The main snowpack concern is small, isolated wind slabs in alpine gullies.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003e5- 15 cm of new snow on Nov. 16th is covering either bare ground, crusts or facetted snow depending on your location. Reports indicate snow depths of up to 80 cm on glaciers, while snow cover remains minimal at treeline and below. Overall, the early-season snowpack is thin and variable.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor current weather conditions, see the\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/map\"\u003etelemetry stations\u0026nbsp;\u003c/a\u003eon the Avalanche Canada map page.\u003c/p\u003e\u003cp\u003eFor weather forecasts, check out Environment Canada's products for \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.weather.gc.ca/en/location/index.html?coords=51.179,-115.569\"\u003eBanff\u003c/a\u003e, \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.weather.gc.ca/en/location/index.html?coords=50.950,-116.033\"\u003eKootenay\u003c/a\u003e and \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.weather.gc.ca/en/location/index.html?coords=51.500,-116.500\"\u003eYoho\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eFor weather maps, graphics and satellite images check out the\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eFor a technical weather forecast check out \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://spotwx.com/\"\u003eSpotWx\u003c/a\u003e\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-16T18:30:37Z","display":"Monday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-17T18:30:37Z","display":"Tuesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-18T18:30:37Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}}],"problems":[{"type":{"value":"windslab","display":"Wind Slab"},"comment":"\u003cp\u003eIsolated small wind slabs are possible in steep alpine lee terrain.\u003c/p\u003e","factors":[{"type":{"value":"elevation","display":"What Elevation?"},"graphic":{"id":"elevation-0-0-1_en","url":"https://assets.avalanche.ca/images/Elevation/Elevation-0-0-1_EN.png","alt":" Alpine"}},{"type":{"value":"aspect","display":"Which Slopes?"},"graphic":{"id":"aspect-1-1-1-1-1-1-1-1_en","url":"https://assets.avalanche.ca/images/Compass/compass-1-1-1-1-1-1-1-1_EN.png","alt":" North, Northeast, East, Southeast, south, Southwest, West, Northwest"}},{"type":{"value":"likelihood","display":"Chances of Avalanches?"},"graphic":{"id":"likelihood-unlikely_en","url":"https://assets.avalanche.ca/images/Likelihood/Likelihood-1_EN.png","alt":" Unlikely"}},{"type":{"value":"size","display":"Expected Size?"},"graphic":{"id":"size-1-2_en","url":"https://assets.avalanche.ca/images/size/Size-1-2_EN.png","alt":" Small - Small"}}],"data":{"elevations":[{"value":"alp","display":"Alpine"}],"aspects":[{"value":"s","display":"s"},{"value":"n","display":"North"},{"value":"ne","display":"Northeast"},{"value":"e","display":"East"},{"value":"se","display":"Southeast"},{"value":"nw","display":"Northwest"},{"value":"w","display":"West"},{"value":"sw","display":"Southwest"}],"aspectElevations":["n_alp","ne_alp","e_alp","se_alp","nw_alp","w_alp","sw_alp","s_alp"],"likelihood":{"value":"unlikely","display":"unlikely"},"expectedSize":{"min":"1.0","max":"1.5"}}}],"terrainAndTravelAdvice":["Be careful with wind-loaded pockets, especially near ridge crests and rollovers."],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-byk","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"notifications":[{"type":"info","content":"\u003cp\u003eArea closures for avalanche control are in effect periodically from November to May. Click \u003ca href=\"https://www.pc.gc.ca/en/pn-np/mtn/securiteenmontagne-mountainsafety/avalanche/declenchementpreventif-controlareas?_ga=2.80778963.573438189.1667223637-385521292.1638363862\"\u003ehere\u003c/a\u003e for more information and maps."}],"media":{"images":[]}},{"id":"eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","slug":"eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","url":"https://avalanche.ca/forecasts/eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","type":"avalancheforecast","area":{"id":"b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","name":"b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","bbox":null},"report":{"id":"eb374a20-3f57-4a4f-882d-7fd06f4eac87_b2a14eb464567902bcdf5b0cf1efe870416fee4de1d80d5b1f6d9cbc1b3bd73a","forecaster":"Parks Canada","dateIssued":"2026-11-10T20:30:16.100Z","validUntil":"2026-11-20T23:00:00.000Z","timezone":"America/Vancouver","title":"Glacier","highlights":"\u003cp\u003eSnow has started to accumulate at upper elevations, but there is not enough of a snowpack to safely travel on skis/snowboards.\u003c/p\u003e\u003cp\u003ePack a transceiver, probe \u0026amp; shovel and factor avalanches into your trip.\u003c/p\u003e\u003cp\u003eDaily avalanche hazard forecasts begin later in November.\u003c/p\u003e","confidence":{"rating":{"value":"moderate","display":"Moderate"},"statements":["We are uncertain due to a limited number of field observations."]},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eThere have been small avalanches on smooth alpine slopes during recent snowfalls.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003eSnow is slowly starting to accumulate at upper elevations, with approximately 30cm of settled snow at treeline. If you decide to give touring a go, plan for hiking at lower elevations, give yourself lots of extra time, and be cautious where wind deposits have created localized pockets of deep snow.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor current conditions check the telemetry stations by clicking on the weather station icons on the Avalanche Canada map page.\u003c/p\u003e\u003cp\u003eFor a weather forecast we recommend Environment Canada's forecast for \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://weather.gc.ca/en/location/index.html?coords=51.301,-117.521\"\u003eRoger's Pass\u003c/a\u003e\u003c/p\u003e\u003cp\u003eFor a weather maps, graphics and satellite images check the \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e\u003c/p\u003e\u003cp\u003eFor a technical forecast check out SpotWx or Windy\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-11T20:30:16Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-12T20:30:16Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-13T20:30:16Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-glacier","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"notifications":[{"type":"info","content":"\u003cp\u003eLarge areas of Glacier National Park are CLOSED for highway avalanche control using EXPLOSIVES. All areas require Winter Permits. Real-time area status is \u003cstrong\u003eonly\u003c/strong\u003e posted \u003ca href=\"https://www.pc.gc.ca/apps/Rogers-Pass\"\u003ehere\u003c/a\u003e.\u003c/p\u003e"}],"media":{"images":[]}},{"id":"9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","slug":"9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","url":"https://avalanche.ca/forecasts/9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","type":"avalancheforecast","area":{"id":"426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","name":"426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","bbox":null},"report":{"id":"9811aa3d-5081-4be0-82ec-1d625fcdf658_426b4bc4f761f2890921214b32ed3bf9f5de086f39b6f755296daf3a3048587e","forecaster":"Parks Canada","dateIssued":"2026-11-13T21:00:00.000Z","validUntil":"2026-11-20T22:00:00.000Z","timezone":"America/Edmonton","title":"Brazeau-Churchill-Cirrus-Wilson-Fryatt-Icefields-Maligne-Marmot-Miette Lake-Pyramid","highlights":"\u003cp\u003e\u003cstrong\u003e\u003cem\u003eAvalanche season is upon us in the alpine.\u0026nbsp; Due to a thin snowpack, glacier travel is also at its trickiest.\u0026nbsp; Use \u0026nbsp;\u003c/em\u003e\u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.pc.gc.ca/station-eng.aspx?d=TODAY\u0026amp;r=5\"\u003e\u003cstrong\u003e\u003cem\u003eWeather Stations\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cem\u003e, the\u0026nbsp;\u003c/em\u003e\u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.mountainconditions.com/\"\u003e\u003cstrong\u003e\u003cem\u003eACMG Mountain Condition Reports\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cem\u003e, and the\u0026nbsp;\u003c/em\u003e\u003c/strong\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/map\"\u003e\u003cstrong\u003e\u003cem\u003eMIN\u003c/em\u003e\u003c/strong\u003e\u003c/a\u003e\u003cstrong\u003e\u003cem\u003e for conditions; or ask for Visitor Safety at 780-852-6155.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e","confidence":{"rating":{"value":"high","display":"High"}},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eDanger is highest after new snowfall, rain, or wind transport.\u0026nbsp;\u0026nbsp; Early season faceting may have weakened the bond of the thin fall snowpack to steep ice gullies/faces.\u0026nbsp; Use extra caution in high, icy arenas â€“ Persistent Slabs have surprised parties in recent years, e.g. late season Mt Athabasca climbers.\u0026nbsp; Avalanche season is here: do your own avalanche forecasting; carry a transceiver, shovel and probe; and to know how to use them.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/early-season-conditions\"\u003eAn early season overview\u003c/a\u003e\u003c/p\u003e\u003cp\u003eWatch out for alpine areas as they gain enough snow for avalanches over the next couple of weeks. High bowls, gullies, and around ridgelines are classic spots for early season avalanches.\u003c/p\u003e\u003cp\u003eVast numbers of open late summer crevasses are now deceptively hidden, by very thin bridges of wind-blown new snow.\u0026nbsp; Roping up and diligent probing, and glacier reading experience are all critical for safe glacier travel.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor current weather conditions, see the\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/map\"\u003etelemetry stations\u0026nbsp;\u003c/a\u003eon the Avalanche Canada map page.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e is available from Avalanche Canada\u003c/p\u003e\u003cp\u003eDetailed local forecasts are available on your favorite weather app.\u003c/p\u003e\u003cp\u003e\u003cbr\u003e\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-13T21:00:00Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-14T21:00:00Z","display":"Saturday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}},{"date":{"value":"2026-11-15T21:00:00Z","display":"Sunday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"norating","display":"No Rating"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"parks-jasper","display":"Parks Canada","isExternal":false,"url":"Parks Canada"},"notifications":[{"type":"info","content":"Seasonal closures for caribou conservation in Jasper National Park are in effect from November to May. For more information, \u003ca href=\"https://www.pc.gc.ca/en/pn-np/ab/jasper/nature/conservation/retablissement-caribou-recovery/mesuresap-bcactions\"\u003eclick here.\u003c/a\u003e"}],"media":{"images":[]}}]{"features":[{"id":"afe9ffd14c0637d10e2530857f8e7a8cba0277f33351d3b31c8f37f4111c6ecf","type":"Feature","bbox":[-116.7663372,50.9276064,-115.4056669,51.9350297],"geometry":{"type":"MultiPolygon","coordinates":[[[[-116.7663,51.898],[-116.7655,51.8827],[-116.7555,51.8766],[-116.7511,51.8697],[-116.7369,51.8671],[-116.7335,51.8658],[-116.7331,51.8603],[-116.7299,51.8539],[-116.7352,51.8506],[-116.7296,51.8458],[-116.7254,51.8392],[-116.7151,51.8337],[-116.6949,51.8365],[-116.6907,51.8301],[-116.6913,51.818],[-116.6776,51.8107],[-116.6698,51.8075],[-116.668,51.8056],[-116.666,51.8056],[-116.6576,51.8019],[-116.6573,51.8004],[-116.6585,51.7982],[-116.6586,51.7959],[-116.6555,51.7936],[-116.6472,51.7901],[-116.6456,51.7887],[-116.6447,51.7865],[-116.6453,51.7832],[-116.6447,51.7789],[-116.6507,51.7666],[-116.6524,51.7592],[-116.6523,51.7562],[-116.6503,51.7533],[-116.6393,51.7499],[-116.6283,51.7451],[-116.6277,51.7435],[-116.6294,51.7396],[-116.6333,51.