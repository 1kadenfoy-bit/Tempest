line","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":false},"version":1,"owner":{"value":"avalanche-canada","display":"Avalanche Canada","isExternal":false,"url":"https://avalanche.ca/en"},"media":{"images":[]}},{"id":"181218e0-ea42-4417-9387-9500569056ab_53bb614cadbd487077d867dec6007dfed090d20fbc0cbfe941451b6af2df33ed","slug":"181218e0-ea42-4417-9387-9500569056ab_53bb614cadbd487077d867dec6007dfed090d20fbc0cbfe941451b6af2df33ed","url":"https://avalanche.ca/forecasts/181218e0-ea42-4417-9387-9500569056ab_53bb614cadbd487077d867dec6007dfed090d20fbc0cbfe941451b6af2df33ed","type":"avalancheforecast","area":{"id":"53bb614cadbd487077d867dec6007dfed090d20fbc0cbfe941451b6af2df33ed","name":"53bb614cadbd487077d867dec6007dfed090d20fbc0cbfe941451b6af2df33ed","bbox":null},"report":{"id":"181218e0-ea42-4417-9387-9500569056ab_53bb614cadbd487077d867dec6007dfed090d20fbc0cbfe941451b6af2df33ed","forecaster":"Avalanche Canada","dateIssued":"2026-10-01T23:00:00.000Z","validUntil":"2026-11-26T00:00:00.000Z","timezone":"America/Vancouver","title":"Akamina-Badshot-Battle-Birkenhead-Blue River-Bonnington-Boundary-Brandywine-Bull-Central Selkirk-Clearwater-Clemina-Coquihalla-Crawford-Crowsnest North-Crowsnest South-Dogtooth-Duffey-East Island-East Kakwa-East Purcell-Elkford East-Elkford West-Esplanade-Flathead-Garibaldi-Goat-Gold-Grohman-Haines Pass-Harrison-Fraser-Homathko-Howson-Jordan-Kakwa-Kispiox-Kitimat-Kokanee-Kootenay Pass-Lizard-Manning-McBride-McGregor-Microwave-Sinclair-Moyie-Nass-Ningunsaw-Norns-North Bulkley-North Island-North Monashee-North Okanagan-North Selkirk-North Shore-Pine Pass-Powell River-Premier-Quesnel-Renshaw-Retallack-Robson-Rossland-Rupert-Sasquatch-Seven Sisters-Shames-Shuswap-Skagit-Sky Pilot-South Bulkley-South Chilcotin-South Island-South Okanagan-Spearhead-Stein-Stewart-St. Mary-Sugarbowl-Tantalus-Taseko-Telkwa-Tetrahedron-Tumbler-Tutshi-Valhalla-West Island-West Purcell-Whatshan-Wheaton-White Pass East-White Pass West-Ymir","highlights":"\u003cp\u003e\u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/early-season-conditions\"\u003eAvalanches hazard may exist where there is snow\u003c/a\u003e. Pack a transceiver, shovel, and probe, and factor avalanches into your trip plan. Daily avalanche forecasts will begin November 25 at 4 PM.\u003c/p\u003e","confidence":{"rating":{"value":"noRating","display":"No Rating"}},"summaries":[{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eMore details can be found in the \u003ca href =\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e.\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-10-02T23:00:00Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-10-03T23:00:00Z","display":"Saturday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-10-04T23:00:00Z","display":"Sunday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":false},"version":1,"owner":{"value":"avalanche-canada","display":"Avalanche Canada","isExternal":false,"url":"https://avalanche.ca/en"},"media":{"images":[]}},{"id":"fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","slug":"fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","url":"https://avalanche.ca/forecasts/fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","type":"avalancheforecast","area":{"id":"d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","name":"d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","bbox":null},"report":{"id":"fc997e84-afec-44f0-933f-d02a27e0ba67_d15dff296f550c29a26e3203191d60ed0a36eeda9361320a324047b0850d77ea","forecaster":"Kananaskis","dateIssued":"2026-11-16T23:30:34.800Z","validUntil":"2026-11-20T23:00:00.000Z","timezone":"America/Vancouver","title":"Bow Valley-Highwood Pass-North 40-Spray - KLakes","highlights":"\u003cp\u003eLee and cross-loaded features in higher alpine terrain could have pockets of wind slab. Ice climbers and scramblers should be mindful of the consequences of even a small avalanche. Check out this link for some information on \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanche.ca/early-season-conditions\"\u003eEarly Season Conditions\u003c/a\u003e\u003c/p\u003e","confidence":{"rating":{"value":"low","display":"Low"}},"summaries":[{"type":{"value":"avalanche-summary","display":"Avalanche Summary"},"content":" \u003cp\u003eNo recent observations or reports.\u003c/p\u003e"},{"type":{"value":"snowpack-summary","display":"Snowpack Summary"},"content":" \u003cp\u003eField observations are very minimal. 20-30cm of snow can be found in higher Alpine areas. Isolated pockets of wind slab in lee and cross-loaded features are possible with slabs up to 50cm deep due to wind loading. The snowpack does not have a lot of layering structure at this time and any avalanche that initiates is likely to fail at the ground.\u003c/p\u003e\u003cp\u003eIce climbers should be thinking about overhead terrain and the influence of winds and warmer temperatures, potentially making triggering more likely.\u003c/p\u003e\u003cp\u003eEven a small avalanche can have big consequences if a terrain trap, such as a cliff or confined gully, is part of the equation.\u003c/p\u003e"},{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eMore details can be found in the \u003ca href =\"https://www.avalanche.ca/weather/forecast\"\u003eMountain Weather Forecast\u003c/a\u003e.\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-17T23:30:34Z","display":"Tuesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-18T23:30:34Z","display":"Wednesday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}},{"date":{"value":"2026-11-19T23:30:34Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"earlyseason","display":"Early Season"}},"tln":{"display":"Treeline","rating":{"value":"earlyseason","display":"Early Season"}},"btl":{"display":"Below Treeline","rating":{"value":"earlyseason","display":"Early Season"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":false},"version":1,"owner":{"value":"kananaskis","display":"Kananaskis","isExternal":false,"url":"https://avalanche.ca/en/forecasts/kananaskis"},"notifications":[{"type":"info","content":"\u003cp\u003eAreas of Kananaskis Country are intermittently closed for avalanche control using EXPLOSIVES. Closures will be indicated in headline below.\u003c/p\u003e"}],"media":{"images":[]}},{"id":"f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","slug":"f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","url":"https://avalanche.ca/forecasts/f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","type":"avalancheforecast","area":{"id":"03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","name":"03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","bbox":null},"report":{"id":"f0c31cb6-b22b-41d2-8b8d-e3e95bf35bc0_03eb3e06c31ffda095ce133e8c6974197efdccd29c7723d078ef27742ff6a762","forecaster":"Avalanche QuÃ©bec","dateIssued":"2026-11-04T13:15:53.800Z","validUntil":"2026-12-01T23:00:00.000Z","timezone":"America/New_York","title":"Chic-Chocs","highlights":"\u003cp\u003e\u003cstrong\u003eTHE BULLETINS WILL BE BACK ON DECEMBER 1ST, 2026.\u003cbr\u003eStay safe in the mountains!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e","confidence":{"rating":{"value":"noRating","display":"No Rating"}},"summaries":[{"type":{"value":"weather-summary","display":"Weather Summary"},"content":" \u003cp\u003eFor the coming weeks, we encourage you to consult the recommended public weather resources when planning a mountain outing, which are available \u003ca target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://avalanchequebec.ca/previsions-meteo-publiques/\"\u003ehere\u003c/a\u003e.\u003c/p\u003e"}],"dangerRatings":[{"date":{"value":"2026-11-05T13:15:53Z","display":"Thursday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"noforecast","display":"No Forecast"}},"tln":{"display":"Treeline","rating":{"value":"noforecast","display":"No Forecast"}},"btl":{"display":"Below Treeline","rating":{"value":"noforecast","display":"No Forecast"}}}},{"date":{"value":"2026-11-06T13:15:53Z","display":"Friday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"noforecast","display":"No Forecast"}},"tln":{"display":"Treeline","rating":{"value":"noforecast","display":"No Forecast"}},"btl":{"display":"Below Treeline","rating":{"value":"noforecast","display":"No Forecast"}}}},{"date":{"value":"2026-11-07T13:15:53Z","display":"Saturday"},"ratings":{"alp":{"display":"Alpine","rating":{"value":"noforecast","display":"No Forecast"}},"tln":{"display":"Treeline","rating":{"value":"noforecast","display":"No Forecast"}},"btl":{"display":"Below Treeline","rating":{"value":"noforecast","display":"No Forecast"}}}}],"problems":[],"terrainAndTravelAdvice":[],"message":null,"season":null,"comment":null,"isFullTranslation":true},"version":1,"owner":{"value":"avalanche-quebec","display":"Avalanche QuÃ©bec","isExternal":false,"url":"https://avalanchequebec.ca"},"media":{"images":[]}}]{"items":[{"submissionID":"19a1d4c6-43b4-420d-aed0-6a9bed7d4aa9","userID":"google-oauth2|110585569771812118831","username":"thomas.thiery01","title":"Backcountry skiing at Fraser Chutes, White Pass","date":"2026-11-18","submissionDatetime":"2026-11-19T18:06:21Z","updatedDatetime":"2026-11-19T18:29:58Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":59.71405,"longitude":-135.08564},"region":"Yukon","imageCount":2,"client":"website","images":[{"id":"c3e88b42-1eb9-4b85-8ef5-415fa8bd7551","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795111143/min/prod/c3e88b42-1eb9-4b85-8ef5-415fa8bd7551.jpg","width":1152,"height":2048},{"id":"2b147efa-1cf5-4491-b7aa-1c4bd410539a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1795111144/min/prod/2b147efa-1cf5-4491-b7aa-1c4bd410539a.jpg","width":1152,"height":2048}],"sawAvalanche":"no","comments":"Backcountry skiing at Fraser Chutes, White Pass. About 50 cm of snow at the bottom of the chute (estimated, not measured) â€” early season, thin cover. Wet snow around mid-chute at about 1,150 m at the start of the day. Sunny, then cloudy. The chute had more powder and was less dense. The couloir (SW aspect) was more wind-affected and denser, but still enjoyable. One storm avalanche observed on Big Kahuna (N aspect), probably size 2, seen from a distance. No major signs of instability. Lots of roller balls and wet snow from the past week, seen everywhere. Skied from 10:00 to 17:00 on a south-southwest (SSW) aspect. The avalanche's elevation band was 1060 to 1745 m."},{"submissionID":"067feb03-431c-4dcb-852a-87c955355e4c","userID":"auth0|6afcda34e8963211b12faeb6","username":"Mike MacGregor","title":"Lazy day at Sunshine Meadows","date":"2026-11-17","submissionDatetime":"2026-11-17T22:53:21Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":51.06457,"longitude":-115.78238},"region":"Central Rockies","imageCount":4,"client":"website","images":[{"id":"94b39ea1-9b46-483e-90bd-d2e3eb698dc1","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955128/min/prod/94b39ea1-9b46-483e-90bd-d2e3eb698dc1.jpg","caption":"2900m - new snow above crust, sugar below","width":2000,"height":1500},{"id":"c2125da4-aeb1-48b4-a09b-33c67f7a8cd0","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955127/min/prod/c2125da4-aeb1-48b4-a09b-33c67f7a8cd0.jpg","caption":"2900m - sugar layer at ground","width":2000,"height":1500},{"id":"ebc4b542-15ef-433f-b1e8-4847b5173c4d","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955128/min/prod/ebc4b542-15ef-433f-b1e8-4847b5173c4d.jpg","caption":"Surface hoar, west aspect, lee slope","width":2000,"height":2667},{"id":"d5ddfc64-cb50-477f-bb94-55eb8cdf24cd","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794955128/min/prod/d5ddfc64-cb50-477f-bb94-55eb8cdf24cd.jpg","caption":"Rime, west aspect, lee slope","width":2000,"height":2667}],"sawAvalanche":"no","instability":["none"],"comments":"Snow pack was highly variable from place to place - everything from just 5cm of new snow on bare rock, to HS 50cm with 15 to 20cm of drifted snow above a thin melt-freeze crust with sugar below. Where present, the crust was supportive. Ski pen varied from near zero to 15cm. Wind varied from none to a light breeze. Reasonably heavy overcast. Deep drifted snow lulled me briefly into forgetting about not-so-buried rocks :-("},{"submissionID":"e7dabda2-873c-4982-b03c-e75c6507b020","userID":"google-oauth2|114021775300373749416","username":"swskier","title":"Metal Dome","date":"2026-11-16","submissionDatetime":"2026-11-17T14:05:05Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":50.1088,"longitude":-123.18613},"region":"Southwest Coast","imageCount":1,"client":"website","images":[{"id":"f4ca8a19-0359-4b69-ac1a-a50128fdfa89","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794924051/min/prod/f4ca8a19-0359-4b69-ac1a-a50128fdfa89.jpg","width":2000,"height":2667}],"sawAvalanche":"no","instability":["windLoading","whumpfing"],"comments":"Went for a look with the new snow and expectations were exceeded. Road in good shape to parking with no snow. Walked ~25min to where trees change to open meadows and started skiing on ~30-50cm base at 1650m. Travel was only possible on skis where old snow existed underneath the fresh storm snow. At ~1850m on the N glacier, probed 185cm. Top 100cm was F-1F progressive density sitting on old snow/melt forms to ground. CT26 BRK down 50cm on a density change. Ski quality was OK with most surfaces wind blown. Ski pen 5-15cm."},{"submissionID":"5dc16163-4d1e-4e1a-afbf-1b3590ff3c14","userID":"auth0|697820b323314501f42be261","username":"Nathan Britt","title":"Hope you like rocks, cause weâ€™ve got heaps of f*cking rocks","date":"2026-11-15","submissionDatetime":"2026-11-16T13:36:23Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["hiking","snowboarding"],"location":{"latitude":51.34044,"longitude":-117.54394},"region":"Selkirks","imageCount":8,"client":"website","images":[{"id":"10147596-26c0-463b-8347-05ac800b0f85","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836068/min/prod/10147596-26c0-463b-8347-05ac800b0f85.jpg","width":2000,"height":2667},{"id":"884466f6-dfb5-48c3-995c-fe073d53606a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836071/min/prod/884466f6-dfb5-48c3-995c-fe073d53606a.jpg","width":2000,"height":2667},{"id":"3cfcd806-2df8-450c-a35d-884f3689774e","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836069/min/prod/3cfcd806-2df8-450c-a35d-884f3689774e.jpg","width":2000,"height":1500},{"id":"28807fee-50c0-4f5b-a5c5-4d028b498859","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836068/min/prod/28807fee-50c0-4f5b-a5c5-4d028b498859.jpg","width":2000,"height":2667},{"id":"830ddde7-0932-45d1-80ba-840c02a595ba","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836067/min/prod/830ddde7-0932-45d1-80ba-840c02a595ba.jpg","width":2000,"height":1500},{"id":"6709cf8f-2f60-4965-9f00-d0210cc2ab5b","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836069/min/prod/6709cf8f-2f60-4965-9f00-d0210cc2ab5b.jpg","width":2000,"height":2667},{"id":"a76166f3-089f-4e65-b6bd-e3d689dcc7c2","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836070/min/prod/a76166f3-089f-4e65-b6bd-e3d689dcc7c2.jpg","width":2000,"height":2667},{"id":"377fc8fb-3cf9-4acf-a735-114a6ca91eb1","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794836070/min/prod/377fc8fb-3cf9-4acf-a735-114a6ca91eb1.jpg","width":2000,"height":2667}],"sawAvalanche":"no","instability":["none"],"comments":"Went for a trundle up hermit today to see how the alpine is shaping up. Snow line is sitting around 1650m. You can still basically hike up to the campground. I ditched the trail runners after 2.5km of hiking and managed to break some kind of a trail on skins from just below 1800m. Freezing level came up disgustingly high over the weekend, precip was still falling as rain at 2000m in the afternoon. Just under 50cm of snow sitting on the tent pads at Hermit Campground but streams are still running above 2000m. Snow quality a little nicer as you get higher above the campground. Averaging 80cm of coverage at the toe of Rogerâ€™s Glacier (2350m south-east aspect) 10 of which fell last night. \n\nTemp at valley bottom(1300m): 4 degrees\nTemp at campground (2100m): 0 degrees \nTemp at glacier (2350m): -2 degrees \n\nSummary: Keep biking."},{"submissionID":"e1f34ddc-c0e9-4c2b-b174-b4f1cfad073b","userID":"auth0|679ef32626e8b488f9351271","username":"crazyplatypus","title":"Scoping out snow at Zoa","date":"2026-11-15","submissionDatetime":"2026-11-16T02:29:47Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["hiking"],"location":{"latitude":49.6267958,"longitude":-121.0800748},"region":"Southwest Coast","imageCount":4,"client":"app","images":[{"id":"min/prod/89e7b504-4c08-404d-ad56-7924fad9278b","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795859/min/prod/89e7b504-4c08-404d-ad56-7924fad9278b.jpg","caption":"Snow at the top of the ridge (35cm)","width":5712,"height":4284},{"id":"min/prod/aa2485fd-bba5-4dc1-9490-315ef8ebd57b","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795861/min/prod/aa2485fd-bba5-4dc1-9490-315ef8ebd57b.jpg","caption":"Parking lotâ€¦. No snow :(","width":4284,"height":5712},{"id":"min/prod/111a3dfb-8c84-46d6-8767-e545632f148a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795863/min/prod/111a3dfb-8c84-46d6-8767-e545632f148a.jpg","caption":"Coming up on to the ridge","width":5712,"height":4284},{"id":"min/prod/9ffa5c4b-e25b-4449-b0dc-af9e4dbeb8d5","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794795877/min/prod/9ffa5c4b-e25b-4449-b0dc-af9e4dbeb8d5.jpg","caption":"@ 1600 m","width":4284,"height":5712}],"sawAvalanche":"no","comments":"Hiked up to the ridge to scope out the snow and do some avi rescue practice but left the skis in the carâ€¦ seemed like too much boot packing for us. There was 35cm of snow on the ridge a lot of sharks. Saw a couple folks out doing a few laps though! "},{"submissionID":"bdb68a24-cbf5-4de4-92dd-1d87027d98fe","userID":"auth0|6afa46bc4a4f012e77453322","username":"maddysparkle","title":"Maddysparklez Megamind Mission","date":"2026-11-15","submissionDatetime":"2026-11-16T00:10:58Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":51.392087699999976,"longitude":-118.351759},"region":"Selkirks","imageCount":4,"client":"app","images":[{"id":"min/prod/47ebf9d3-340d-4766-a7de-3dc13b71a784","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787260/min/prod/47ebf9d3-340d-4766-a7de-3dc13b71a784.jpg","caption":"Yummy early season snow","width":3024,"height":4032},{"id":"min/prod/b653a597-2fc4-486c-991f-e413a6d1f362","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787270/min/prod/b653a597-2fc4-486c-991f-e413a6d1f362.jpg","caption":"Mmmmm alders","width":4284,"height":5712},{"id":"min/prod/556f0e5d-a8c3-459e-8419-e132d130e57a","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787276/min/prod/556f0e5d-a8c3-459e-8419-e132d130e57a.jpg","caption":"Lots of rocks","width":4284,"height":5712},{"id":"min/prod/02718d3b-e737-4929-8c3a-5a0c53c5e15f","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794787664/min/prod/02718d3b-e737-4929-8c3a-5a0c53c5e15f.jpg","caption":"Dawg for reference ","width":5712,"height":4284}],"sawAvalanche":"no","instability":["none"],"comments":"Up to 30cm of well consolidated snow at 1800m with 5-10cm accumulating over 24hours. Graupel \u0026 some stellar stellars overnight. Lots of wind, not much transport at our elevation. Lower elevations lost snow coverage quickly. Paw pen 5cm tested by our dawg. 10/10 would recommend an early season mission. "},{"submissionID":"4395f1fa-5b7c-4b3d-8b49-394bc6765663","userID":"google-oauth2|113028194556210400866","username":"skiasessippi","title":"Should have brought skates","date":"2026-11-14","submissionDatetime":"2026-11-15T20:04:28Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing"],"location":{"latitude":50.627126299999986,"longitude":-116.49466239999998},"region":"Purcells","client":"app","sawAvalanche":"no","comments":"6-8 inches of snow for the entire trail and even less above the lower lake.\nSignificant surface hoar forming throughout the day. Facets at ground level. Lower lake is frozen enough for skating but the area is not skiable yet."},{"submissionID":"2d5107f2-3c6c-413f-bb48-cf93483c600c","userID":"auth0|6af9d476026c8efbeabee507","username":"ryanteppan","title":"Bow Hut to Mt Rhondda + Mount Habel (CT at base","date":"2026-11-13","submissionDatetime":"2026-11-15T16:12:28Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["skiing","mountaineering"],"location":{"latitude":51.64950639999999,"longitude":-116.55707940000002},"region":"Central Rockies","imageCount":5,"client":"app","images":[{"id":"min/prod/6c476ce8-d562-4afc-a40b-5d9961cff339","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757980/min/prod/6c476ce8-d562-4afc-a40b-5d9961cff339.jpg","caption":"CT at base of mount Habel\n","width":1290,"height":2796},{"id":"min/prod/444248f9-a8d3-45d8-ab44-d085ce2c1576","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757982/min/prod/444248f9-a8d3-45d8-ab44-d085ce2c1576.jpg","width":1290,"height":2796},{"id":"min/prod/f9a82777-a4c3-425e-a806-a6a560549f38","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757986/min/prod/f9a82777-a4c3-425e-a806-a6a560549f38.jpg","width":1290,"height":2796},{"id":"min/prod/814917b9-4c4f-4e37-ba42-63b8468e31a9","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757989/min/prod/814917b9-4c4f-4e37-ba42-63b8468e31a9.jpg","caption":"Photo from where I lost my ski and the area it likely ended up, my ski is a Blizzard Zero G (with pin bindings-no brakes)","width":1290,"height":2796},{"id":"min/prod/dfaa56ef-5ff5-4682-9743-2bbf208b4d54","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794757991/min/prod/dfaa56ef-5ff5-4682-9743-2bbf208b4d54.jpg","caption":"On way back to Bow hut-pic of my ski if anyone stumbles upon my lost one. Unlikely but my # is 403-431-2476\n","width":1290,"height":2796}],"sawAvalanche":"no","comments":"Ski touring across Wapta icefield and a summit of Rhondda on Nov. 13, 2026. Group of 3. Snow was variable with wind loading in areas, no shooting cracks or whumphing. Descended Rhondda then did a CT at the base of Mount Habel: CTM13 30cm down, RP. Included pics, At spot of the column test I lost 1 of my touring skis down the slope. Included a photo of area, if anyone finds it by chance my # is 403-431-2476. Will be going to peyto hut ~Nov 20th to look around for it. Also worth mentioning there were only a couple open crevasses around Rhondda and didnâ€™t come across any hidden crevasses while traversing to and from bow hut from that area."},{"submissionID":"4f0fa9f4-9282-40cc-a77a-d2bda5ff33b1","userID":"auth0|54ced78c4a76765d506c43a4","username":"ksharman","title":"Bullmoose snow - thumbs down","date":"2026-11-13","submissionDatetime":"2026-11-14T05:02:00Z","schemaVersions":{"dataSchemaId":"data_3.0.0"},"activities":["snowshoeing"],"location":{"latitude":55.03441990000001,"longitude":-121.51991159999999},"region":"North Rockies","imageCount":2,"client":"app","images":[{"id":"min/prod/e8c9834a-6801-4f7d-abb7-8b383ee768ee","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794632170/min/prod/e8c9834a-6801-4f7d-abb7-8b383ee768ee.jpg","width":4284,"height":5712},{"id":"min/prod/58f57bd9-d0c3-460d-8623-698001fc0197","url":"https://res.cloudinary.com/avcan-min/image/upload/v1794632175/min/prod/58f57bd9-d0c3-460d-8623-698001fc0197.jpg","width":2944,"height":3926}],"sawAvalanche":"no","instability":["warming"],"comments":"Height of snow 35-50 cm at treeline. 10 cm pretty good powder on top. The rest of the snowpack got really baked by this weekâ€™s warmup and it probably rained high up before the 10 cm snow. Wet and mushy, almost isothermic. We were sinking in almost down to ground. Would have been challenging skiing but we were on snowshoes. "}]}{"features":[{"id":"010016cb778a7962e0174e68d5a278372db93924e19e450052de07b95eb72c85","type":"Feature","bbox":[-114.16658349999994,48.997686300000055,-113.65343739999997,49.20440260000004],"geometry":{"type":"MultiPolygon","coordinates":[[[[-114.1666,49.1361],[-114.1622,49.129],[-114.158,49.127],[-114.1577,49.1245],[-114.1555,49.1229],[-114.1548,49.1205],[-114.1501,49.118],[-114.1496,49.1134],[-114.1502,49.1098],[-114.1536,49.1047],[-114.1538,49.1026],[-114.1468,49.0932],[-114.1318,49.0832],[-114.1312,49.0807],[-114.1289,49.0789],[-114.1156,49.0743],[-114.1089,49.0668],[-114.1038,49.0632],[-114.0906,49.0586],[-114.0866,49.0586],[-114.0798,49.061],[-114.0791,49.0569],[-114.0773,49.0551],[-114.0663,49.0483],[-114.0616,49.0465],[-114.0626,49.0435],[-114.0609,49.0361],[-114.0568,49.0282],[-114.0534,49.0264],[-114.0579,49.0184],[-114.0719,49.005],[-114.0709,49.0014],[-114.0682,48.9993],[-113.6534,48.9977],[-113.6534,49.0728],[-113.6909,49.0731],[-113.6897,49.0712],[-113.6931,49.0708],[-113.6932,49.0695],[-113.691,49.0668],[-113.6907,49.0648],[-113.6921,49.0633],[-113.6954,49.0641],[-113.6969,49.0634],[-113.6964,49.0604],[-113.6953,49.0614],[-113.6916,49.0565],[-113.6925,49.0536],[-113.6947,49.0513],[-113.694,49.0505],[-113.6906,49.0496],[-113.6889,49.0464],[-113.6855,49.0455],[-113.6875,49.0443],[-113.6844,49.0423],[-113.6826,49.0395],[-113.685,49.0376],[-113.6827,49.0355],[-113.683,49.0336],[-113.6821,49.0328],[-113.683,49.0311],[-113.6824,49.0296],[-113.6828,49.0282],[-113.6899,49.0247],[-113.6901,49.0237],[-113.6913,49.0232],[-113.6905,49.0224],[-113.691,49.0214],[-113.7349,49.0214],[-113.7349,49.0736],[-113.7866,49.0737],[-113